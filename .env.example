# Optional direct mode for local testing. Do not commit your real key.
GEMINI_API_KEY=

# Shared demo proxy. Its Gemini key is stored as a Cloudflare secret.
GEMINI_PROXY_URL=https://refugio-gemini-proxy.juliocabrera721.workers.dev

# Optional stable JWT signing key (generate with: openssl rand -base64 32).
# If omitted, the app generates a temporary key and tokens expire on restart.
JWT_SECRET=
